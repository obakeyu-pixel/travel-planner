{
  "name": "travel-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "tsc -b && vite build",
    "cap:sync": "npm run build && node ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:android": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:ios": "node ./node_modules/@capacitor/cli/bin/capacitor open ios",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.45.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "untun": "^0.2.2",
    "vite": "^8.3.0"
  }
}
