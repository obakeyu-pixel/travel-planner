opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to App Store Connect"
  lane :release do
    # 0. CI用の一時キーチェーンを作成（codesignがGUIプロンプトで固まるのを完全防止）
    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      add_to_search_list: true
    )

    # 1. App Store Connect API Key 設定
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "fastlane/AuthKey.p8",
      in_house: false
    )

    # 2. 証明書上限枠の自動クリーンアップ（古い証明書を削除して空き枠を維持）
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      if dist_certs.length >= 2
        dist_certs.first.delete!
      end
    rescue => e
      UI.message("Certificate cleanup note: #{e.message}")
    end

    # 3. Apple公式の配布証明書（Distribution Certificate）を取得し、CIキーチェーンへ登録
    keychain_file = File.expand_path("~/Library/Keychains/ci_keychain-db")
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_file,
      keychain_password: "ci_password"
    )

    # 4. codesignがパスワード入力なしで秘密鍵を使えるよう、ACL（パーティションリスト）を更新
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k ci_password #{keychain_file} || true")

    # 5. App Store用プロビジョニングプロファイルを取得/作成
    get_provisioning_profile(
      app_identifier: "com.tabiplan.travelapp",
      api_key: api_key
    )

    # 6. プロジェクトの署名設定を手動署名に切り替え ＆ プロファイルをターゲットに紐付け
    profile_path = Actions.lane_context[Actions::SharedValues::SIGH_PROFILE_PATH]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: "NM2JJ63FAN"
    )

    update_project_provisioning(
      xcodeproj: "App.xcodeproj",
      profile: profile_path,
      target_filter: ".*"
    )

    # 7. 正式署名してIPAをビルド（事前解決済みパッケージを使用しフリーズを防止）
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build-output",
      output_name: "App.ipa",
      skip_package_dependencies_resolution: true,
      xcargs: "-disableAutomaticPackageResolution DEVELOPMENT_TEAM='NM2JJ63FAN' PROVISIONING_PROFILE_SPECIFIER='#{ENV['SIGH_UUID']}' CODE_SIGN_STYLE='Manual' CODE_SIGN_IDENTITY='Apple Distribution'"
    )

    # 8. App Store Connectへ高速アップロード
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
