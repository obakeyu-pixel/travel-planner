opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to App Store Connect"
  lane :release do
    # 1. App Store Connect API Key 設定
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "fastlane/AuthKey.p8",
      in_house: false
    )

    # 2. Apple公式の配布証明書（Distribution Certificate）を取得/作成
    get_certificates(api_key: api_key)

    # 3. App Store用プロビジョニングプロファイルを取得/作成
    get_provisioning_profile(
      app_identifier: "com.tabiplan.travelapp",
      api_key: api_key
    )

    # 4. プロジェクトのチームIDと署名設定を自動同期
    team_id = Actions.lane_context[Actions::SharedValues::SIGH_TEAM_ID]
    if team_id
      update_project_team(
        path: "App.xcodeproj",
        team_id: team_id
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj"
    )

    # 5. 正式署名してIPAをビルド
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build-output",
      output_name: "App.ipa"
    )

    # 6. App Store Connectへ自動アップロード
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end
end
