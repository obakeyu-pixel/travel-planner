opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to App Store Connect"
  lane :release do
    # 1. App Store Connect API Key 設定
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "fastlane/AuthKey.p8",
      in_house: false
    )

    # 2. 証明書上限枠の自動クリーンアップ（前回作成された不要な証明書を削除して空き枠を作成）
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      if dist_certs.length >= 2
        dist_certs.first.delete!
      end
    rescue => e
      UI.message("Certificate cleanup note: #{e.message}")
    end

    # 3. Apple公式の配布証明書（Distribution Certificate）を取得/作成
    get_certificates(api_key: api_key)

    # 4. App Store用プロビジョニングプロファイルを取得/作成
    get_provisioning_profile(
      app_identifier: "com.tabiplan.travelapp",
      api_key: api_key
    )

    # 5. プロファイルからTeam IDを自動抽出し、プロジェクトとビルド引数に反映
    profile_path = Actions.lane_context[Actions::SharedValues::SIGH_PROFILE_PATH]
    plist_xml = sh("security cms -D -i #{profile_path}")
    team_id = plist_xml[/<key>TeamIdentifier<\/key>.*?<string>([^<]+)<\/string>/m, 1]
    UI.message("Extracted Development Team ID: #{team_id}")

    if team_id
      update_project_team(
        path: "App.xcodeproj",
        team_id: team_id
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id
    )

    update_project_provisioning(
      xcodeproj: "App.xcodeproj",
      profile: profile_path,
      target_filter: ".*"
    )

    # 6. 正式署名してIPAをビルド（Team IDとプロファイルを明示指定）
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build-output",
      output_name: "App.ipa",
      xcargs: "DEVELOPMENT_TEAM='#{team_id}' PROVISIONING_PROFILE_SPECIFIER='#{ENV['SIGH_UUID']}' CODE_SIGN_STYLE='Manual' CODE_SIGN_IDENTITY='Apple Distribution'"
    )

    # 6. App Store Connectへ高速アップロード
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
